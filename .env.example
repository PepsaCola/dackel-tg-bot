# Токен від @BotFather
BOT_TOKEN=123456789:AAAA-your-token
# ID групи або каналу (для звичайної групи: -123..., для супергрупи/каналу: -100...)
CHANNEL_ID=-1001234567890
# Ключі для застосунку, через кому (можна кілька: для ротації або різних платформ)
API_KEYS=change-me-long-random-string
# production | development (у development відкривається /docs)
APP_ENV=development
LOG_LEVEL=INFO
TIMEZONE=Europe/Kyiv
# Скільки відгуків на хвилину дозволено з однієї IP-адреси
RATE_LIMIT_PER_MINUTE=5
# Для веб-версії застосунку на іншому домені: дозволені домени через кому (порожньо = CORS вимкнено)
CORS_ORIGINS=
# Демо-сторінка з прикладом підключення на /demo/
DEMO_ENABLED=true